# Spotify OAuth app credentials (https://developer.spotify.com/dashboard)
# The redirect URI MUST use 127.0.0.1, not localhost (Spotify rule since Nov 2025).
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Google OAuth credentials (console.cloud.google.com).
# NOTE: OAuth does NOT work for YouTube Music writes (internal API rejects custom
# clients with HTTP 400). These are retained only for completeness; the working
# auth path is browser cookies via the extension/bridge. See bridge/README.md.
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

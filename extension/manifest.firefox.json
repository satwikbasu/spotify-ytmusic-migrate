{
  "manifest_version": 3,
  "name": "Playlist Migrator - YouTube Music connector",
  "version": "0.2.0",
  "description": "Lets the Playlist Migrator app on this computer use your signed-in YouTube Music session. Nothing leaves your computer.",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Playlist Migrator"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capture@playlist-migrator.app",
      "strict_min_version": "115.0"
    }
  }
}
